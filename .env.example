# Copy to .env.local for local development, and set the same values in Vercel.

# Supabase -----------------------------------------------------------------
# Project Settings → API. The anon key is safe in the browser; row level
# security is what actually protects the data.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Claude -------------------------------------------------------------------
# Writes the letters and runs the web research. https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Site ---------------------------------------------------------------------
# Used to build the Google OAuth redirect. No trailing slash.
# Local: http://localhost:3000   Production: https://your-domain.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000
