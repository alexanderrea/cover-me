# Copy to .env.local for local development, and set the same values in Vercel.

# Supabase -----------------------------------------------------------------
# Project Settings → API. The anon key is safe in the browser; row level
# security is what actually protects the data.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Key encryption ----------------------------------------------------------
# Encrypts each user's stored Anthropic key at rest. Required.
# Generate one with:  openssl rand -hex 32
# Changing it makes every already-stored key unreadable — users would have to
# re-enter theirs.
ENCRYPTION_KEY=

# Claude -------------------------------------------------------------------
# NOT used by the app — COVER ME runs on each user's own key, added in
# Settings. This is only for `npm run smoke`. https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Site ---------------------------------------------------------------------
# Used to build the Google OAuth redirect. No trailing slash.
# Local: http://localhost:3000   Production: https://your-domain.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000
